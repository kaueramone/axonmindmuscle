# Supabase — projeto "Axon Plataforma"
NEXT_PUBLIC_SUPABASE_URL=https://ujgbyvbizhkhzogroshk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site (usada nos redirecionamentos de autenticação)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile — chave pública do widget.
# A chave secreta NÃO vive aqui: é configurada no Supabase, em
# Authentication → Attack Protection → CAPTCHA. Sem esta variável o widget
# não aparece e os formulários funcionam normalmente.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Stripe — modo de teste primeiro (sk_test_..., pk_test_...).
# A chave secreta e o segredo do webhook NUNCA entram no repositório:
# vivem apenas nas variáveis de ambiente da Vercel.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Identificadores dos preços criados no Stripe (price_...).
STRIPE_PRICE_PRO_MONTH_EUR=
STRIPE_PRICE_PRO_YEAR_EUR=
STRIPE_PRICE_PRO_MONTH_BRL=
STRIPE_PRICE_PRO_YEAR_BRL=

# Cupões do código FUNDADORES (coupon_...): 25% no mensal, 40% no anual.
# O código é validado na aplicação; no Stripe só vive a percentagem.
STRIPE_COUPON_FOUNDERS_MONTH=
STRIPE_COUPON_FOUNDERS_YEAR=

# Necessária apenas ao webhook, que escreve sem sessão de utilizador.
SUPABASE_SERVICE_ROLE_KEY=
